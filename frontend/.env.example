# ---------------------------------------------------------------------------
# Sonicly – Frontend Environment Variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development.
# In production (Vercel / Docker / etc.), set these as real environment vars.

# Public URL of the site — MUST be set to the real domain in production.
# Controls canonical links, Open Graph URLs, og:image paths, and the sitemap.
# If unset, falls back to http://localhost:3000 (fine for local dev only).
# Example: https://sonicly.app
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Base URL of the backend API.
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api
