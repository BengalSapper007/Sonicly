# =============================================================================
# Sonicly — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (Docker)
# ---------------------------------------------------------------------------
POSTGRES_DB=sonicly
POSTGRES_USER=sonicly
POSTGRES_PASSWORD=sonicly_dev_password

# ---------------------------------------------------------------------------
# Backend — NestJS
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Prisma
DATABASE_URL=postgresql://sonicly:sonicly_dev_password@localhost:5432/sonicly

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=change_this_to_another_long_random_secret

# CORS — Frontend origin
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Frontend — Next.js
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
