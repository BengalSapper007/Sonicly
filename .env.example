# =============================================================================
# Sonicly — Environment Variables
# NEVER commit this file to source control.
# =============================================================================

# ---------------------------------------------------------------------------
# PostgreSQL (Docker)
# ---------------------------------------------------------------------------
POSTGRES_DB=sonicly
POSTGRES_USER=sonicly
POSTGRES_PASSWORD=sonicly_dev_password

# ---------------------------------------------------------------------------
# Backend — NestJS
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3001

# Prisma
DATABASE_URL=postgresql://sonicly:sonicly_dev_password@localhost:5432/sonicly

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=change_this_to_another_long_random_secret

# CORS
CORS_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Admin Catalog Ingestion
# ---------------------------------------------------------------------------
# Used only by the internal catalog ingestion API.
# NEVER expose this to the frontend.
ADMIN_API_KEY=change_this_to_a_strong_random_key

# ---------------------------------------------------------------------------
# Cloudflare R2 — Media Storage
# ---------------------------------------------------------------------------

# Cloudflare account ID
R2_ACCOUNT_ID=your_cloudflare_account_id

# R2 API token credentials
# Token should have Object Read & Write access to the 'sonicly' bucket only.
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# R2 bucket
R2_BUCKET_NAME=sonicly

# S3-compatible R2 configuration
R2_REGION=auto
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com

# Presigned URL lifetime
# 3600 = 1 hour
R2_SIGNED_URL_EXPIRY=3600

# ---------------------------------------------------------------------------
# Frontend — Next.js
# ---------------------------------------------------------------------------

# This is NOT a secret.
NEXT_PUBLIC_API_URL=http://localhost:3001